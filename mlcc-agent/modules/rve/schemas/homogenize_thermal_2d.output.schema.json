  "required": [
    "schema_version",
    "dimension",
    "physics",
    "rve_id",
    "mesh_id",
    "tensor",
    "tensor_unit",
    "boundary_condition",
    "pore_model",
    "cells",
    "load_count",
    "effective_material_artifact",
