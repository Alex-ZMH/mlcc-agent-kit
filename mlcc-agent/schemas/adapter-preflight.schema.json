{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlcc.adapter-preflight.v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlcc.adapter-preflight.v1"
    },
    "ready": {
      "type": "boolean"
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "passed",
              "failed",
              "warning",
              "not_checked",
              "not_applicable"
            ]
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "id",
          "status",
          "message"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "ready",
    "errors",
    "warnings",
    "checks"
  ],
  "additionalProperties": false
}
