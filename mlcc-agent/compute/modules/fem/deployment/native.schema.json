{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Host deployment only, never scientific input. Deployment.load additionally validates Linux, executable files, canonical confined paths, and relational limits.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "fea.deployment.native.v1"
    },
    "transport": {
      "const": "native_linux"
    },
    "python": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "linux_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "threads": {
      "type": "integer",
      "minimum": 1,
      "maximum": 1
    },
    "max_cells": {
      "type": "integer",
      "minimum": 1,
      "maximum": 50000
    }
  },
  "required": [
    "schema_version",
    "transport",
    "python",
    "linux_root",
    "timeout_seconds",
    "threads",
    "max_cells"
  ],
  "additionalProperties": false
}
