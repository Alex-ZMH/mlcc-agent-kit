{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlcc.adapter-result.v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlcc.adapter-result.v1"
    },
    "execution_status": {
      "type": "string",
      "enum": [
        "succeeded",
        "failed",
        "blocked"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evidence_kind": {
          "type": "string",
          "enum": [
            "none",
            "interface_selfcheck",
            "demo",
            "analytic_benchmark",
            "real_computation",
            "experimental_data"
          ]
        },
        "method": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "units": {
          "type": "object"
        },
        "conditions": {
          "type": "object"
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "reference",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "evidence_kind",
        "method",
        "backend",
        "units",
        "conditions",
        "applicability",
        "sources"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": "object"
    },
    "quality": {
      "type": "object",
      "properties": {
        "numerical": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "warning",
                  "not_checked",
                  "not_applicable"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "message"
            ],
            "additionalProperties": false
          }
        },
        "scientific": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "enum": [
                  "passed",
                  "failed",
                  "warning",
                  "not_checked",
                  "not_applicable"
                ]
              },
              "message": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "id",
              "status",
              "message"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "numerical",
        "scientific"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "path",
          "media_type",
          "description"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "execution_status",
    "provenance",
    "results",
    "quality",
    "errors",
    "warnings",
    "limitations",
    "artifacts"
  ],
  "additionalProperties": false
}
