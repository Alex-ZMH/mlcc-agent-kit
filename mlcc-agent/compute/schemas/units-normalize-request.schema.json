{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlcc.units-request.v1"
    },
    "action": {
      "const": "normalize"
    },
    "kind": {
      "type": "string",
      "minLength": 1
    },
    "quantity": {
      "type": [
        "object",
        "number",
        "string"
      ]
    },
    "bare_unit": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "object"
    }
  },
  "required": [
    "schema_version",
    "action",
    "kind",
    "quantity"
  ],
  "additionalProperties": false
}
