{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlcc.module.v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlcc.module.v1"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "interface_version": {
      "const": "1.0"
    },
    "kind": {
      "type": "string",
      "enum": [
        "scientific",
        "interface_selfcheck",
        "demo"
      ]
    },
    "implementation": {
      "type": "string",
      "enum": [
        "implemented",
        "not_integrated"
      ]
    },
    "adapter": {
      "type": [
        "object",
        "null"
      ],
      "properties": {
        "entry": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "entry"
      ],
      "additionalProperties": false
    },
    "dependencies": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "python_package",
              "executable"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "kind",
          "name"
        ],
        "additionalProperties": false
      }
    },
    "operations": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string",
            "minLength": 1
          },
          "input_schema": {
            "type": "string",
            "minLength": 1
          },
          "output_schema": {
            "type": "string",
            "minLength": 1
          },
          "execution": {
            "type": "string",
            "enum": [
              "sync",
              "queued"
            ]
          },
          "timeout_seconds": {
            "type": "number",
            "minimum": 0.01
          },
          "evidence_kinds": {
            "type": "array",
            "items": {
              "type": "string",
              "enum": [
                "none",
                "interface_selfcheck",
                "demo",
                "analytic_benchmark",
                "real_computation",
                "experimental_data"
              ]
            }
          },
          "required_checks": {
            "type": "object",
            "properties": {
              "numerical": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              },
              "scientific": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            },
            "required": [
              "numerical",
              "scientific"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "description",
          "input_schema",
          "output_schema",
          "execution",
          "timeout_seconds",
          "evidence_kinds",
          "required_checks"
        ],
        "additionalProperties": false
      }
    },
    "engine": {
      "type": "string",
      "minLength": 1
    },
    "task_provider": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "id",
    "title",
    "description",
    "version",
    "interface_version",
    "kind",
    "implementation",
    "adapter",
    "dependencies",
    "operations"
  ],
  "additionalProperties": false
}
