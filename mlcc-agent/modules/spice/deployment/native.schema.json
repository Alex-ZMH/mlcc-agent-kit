{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "Host deployment only, never scientific input. Deployment.load additionally validates Linux, executable files, canonical confined paths, and relational limits.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "spice.deployment.native.v1"
    },
    "transport": {
      "const": "native_linux"
    },
    "python": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "ngspice": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "linux_root": {
      "type": "string",
      "minLength": 1,
      "pattern": "^/"
    },
    "solver_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 120
    },
    "client_timeout_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 150
    },
    "max_ac_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 21000
    },
    "max_transient_samples": {
      "type": "integer",
      "minimum": 1,
      "maximum": 100000
    },
    "max_branches": {
      "type": "integer",
      "minimum": 1,
      "maximum": 8
    }
  },
  "required": [
    "schema_version",
    "transport",
    "python",
    "ngspice",
    "linux_root",
    "solver_timeout_seconds",
    "client_timeout_seconds",
    "max_ac_samples",
    "max_transient_samples",
    "max_branches"
  ],
  "additionalProperties": false
}
