{
  "schemaVersion": "matterai.bundle.v2",
  "name": "mlcc-agent",
  "title": "MLCC 原子建模与多链路仿真能力包",
  "version": "0.58.0",
  "description": "独立 MLCC 能力包：可追溯模型、ABACUS 电子/弹性/缺陷、Phonopy 位移与原生力、LAMMPS 工程输入解析、设计适配和 Slurm/MCP。科学资格逐项验收。",
  "agent": {
    "name": "mlcc",
    "entry": "agents/mlcc/AGENT.md",
    "skills": [
      "model-mlcc-structures",
      "run-mlcc-dft",
      "compute-mlcc-properties",
      "run-mlcc-md",
      "run-mlcc-scales"
    ]
  },
  "mcpServers": [
    {
      "name": "mlcc",
      "transport": "stdio",
      "runtime": "python",
      "entry": "tools/mlcc_mcp.py",
      "args": [
        "--site",
        "zeus://workspace/current/configs/site.v100.json",
        "--workspace",
        "zeus://workspace/current"
      ],
      "allowedTools": [
        "mlcc_list_tasks",
        "mlcc_prepare_calculation",
        "mlcc_transfer_calculation",
        "mlcc_submit_calculation",
        "mlcc_query_calculation",
        "mlcc_cancel_calculation",
        "mlcc_collect_calculation"
      ],
      "requiredEnv": [],
      "permissions": {
        "filesystem": "workspace-write",
        "network": true
      }
    }
  ],
  "requirements": {
    "capabilities": [
      "chat",
      "files",
      "tools",
      "network"
    ]
  },
  "harness": {
    "cases": "harness/cases",
    "format": "matterai.case.v2"
  },
  "catalog": {
    "category": "simulation"
  },
  "risk": "networked"
}
