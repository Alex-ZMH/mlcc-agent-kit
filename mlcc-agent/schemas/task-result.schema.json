{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mlcc.task-result.v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlcc.task-result.v1"
    },
    "task_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,95}$"
    },
    "module": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$"
        },
        "version": {
          "type": "string",
          "pattern": "^\\d+\\.\\d+\\.\\d+$"
        },
        "interface_version": {
          "const": "1.0"
        },
        "kind": {
          "type": "string",
          "enum": [
            "scientific",
            "interface_selfcheck",
            "demo"
          ]
        }
      },
      "required": [
        "id",
        "version",
        "interface_version",
        "kind"
      ],
      "additionalProperties": false
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*$"
    },
    "execution": {
      "type": "object",
      "properties": {
        "status": {
          "type": "string",
          "enum": [
            "queued",
            "running",
            "succeeded",
            "failed",
            "blocked",
            "interrupted"
          ]
        },
        "created_at": {
          "type": "string",
          "minLength": 1
        },
        "updated_at": {
          "type": "string",
          "minLength": 1
        },
        "backend_exit_code": {
          "type": [
            "integer",
            "null"
          ]
        },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "status": {
                "type": "string",
                "minLength": 1
              },
              "at": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "status",
              "at"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "status",
        "created_at",
        "updated_at",
        "backend_exit_code",
        "events"
      ],
      "additionalProperties": false
    },
    "input": {
      "type": "object",
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "payload": {
          "type": "object"
        }
      },
      "required": [
        "schema",
        "payload"
      ],
      "additionalProperties": false
    },
    "provenance": {
      "type": "object",
      "properties": {
        "evidence_kind": {
          "type": "string",
          "enum": [
            "none",
            "interface_selfcheck",
            "demo",
            "analytic_benchmark",
            "real_computation",
            "experimental_data"
          ]
        },
        "method": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "backend": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "minLength": 1
            },
            "version": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "name",
            "version"
          ],
          "additionalProperties": false
        },
        "units": {
          "type": "object"
        },
        "conditions": {
          "type": "object"
        },
        "applicability": {
          "type": "string",
          "minLength": 1
        },
        "sources": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "minLength": 1
              },
              "reference": {
                "type": "string",
                "minLength": 1
              },
              "description": {
                "type": "string",
                "minLength": 1
              }
            },
            "required": [
              "kind",
              "reference",
              "description"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "evidence_kind",
        "method",
        "backend",
        "units",
        "conditions",
        "applicability",
        "sources"
      ],
      "additionalProperties": false
    },
    "results": {
      "type": [
        "object",
        "null"
      ]
    },
    "quality": {
      "type": "object",
      "properties": {
        "numerical": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "warning",
                "not_checked"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "warning",
                      "not_checked",
                      "not_applicable"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "status",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "checks"
          ],
          "additionalProperties": false
        },
        "scientific": {
          "type": "object",
          "properties": {
            "status": {
              "type": "string",
              "enum": [
                "passed",
                "failed",
                "warning",
                "not_checked"
              ]
            },
            "checks": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "id": {
                    "type": "string",
                    "minLength": 1
                  },
                  "status": {
                    "type": "string",
                    "enum": [
                      "passed",
                      "failed",
                      "warning",
                      "not_checked",
                      "not_applicable"
                    ]
                  },
                  "message": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "id",
                  "status",
                  "message"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "status",
            "checks"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "numerical",
        "scientific"
      ],
      "additionalProperties": false
    },
    "errors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "minLength": 1
          },
          "message": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "code",
          "message"
        ],
        "additionalProperties": false
      }
    },
    "warnings": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "path": {
            "type": "string",
            "minLength": 1
          },
          "media_type": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string",
            "minLength": 1
          },
          "size_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "evidence_kind": {
            "type": "string",
            "enum": [
              "none",
              "interface_selfcheck",
              "demo",
              "analytic_benchmark",
              "real_computation",
              "experimental_data"
            ]
          }
        },
        "required": [
          "path",
          "media_type",
          "description",
          "size_bytes",
          "evidence_kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "task_id",
    "module",
    "operation",
    "execution",
    "input",
    "provenance",
    "results",
    "quality",
    "errors",
    "warnings",
    "limitations",
    "artifacts"
  ],
  "additionalProperties": false
}
