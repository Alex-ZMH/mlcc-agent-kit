{
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "rve.result.v1"
    },
    "dimension": {
      "const": 2
    },
    "physics": {
      "const": "thermal"
    },
    "rve_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "mesh_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "tensor": {
      "type": "array",
      "items": {
        "type": "array",
        "items": {
          "type": "number"
        },
        "minItems": 2,
        "maxItems": 2
      },
      "minItems": 2,
      "maxItems": 2
    },
    "tensor_unit": {
      "const": "W/(m K)"
    },
    "boundary_condition": {
      "type": "string",
      "enum": [
        "periodic",
        "affine_dirichlet"
      ]
    },
    "pore_model": {
      "type": "string",
      "enum": [
        "explicit",
        "insulating_cavity"
      ]
    },
    "cells": {
      "type": "integer",
      "minimum": 1
    },
    "load_count": {
      "const": 2
    },
    "effective_material_artifact": {
      "type": "string",
      "pattern": "^artifacts/[A-Za-z0-9_./-]+$"
    },
    "readback_artifact": {
      "type": "string",
      "pattern": "^artifacts/[A-Za-z0-9_./-]+$"
    },
    "coordinate_artifact": {
      "type": "string",
      "pattern": "^artifacts/[A-Za-z0-9_./-]+$"
    },
