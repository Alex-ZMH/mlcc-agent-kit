{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "mlcc.units-request.v1"
    },
    "action": {
      "const": "normalize_fields"
    },
    "payload": {
      "type": "object"
    },
    "fields": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "bare_unit": {
            "type": "string",
            "minLength": 1
          },
          "source": {
            "type": "object"
          }
        },
        "required": [
          "kind"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema_version",
    "action",
    "payload",
    "fields"
  ],
  "additionalProperties": false
}
