{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "schema_version",
    "name",
    "version",
    "interface_version",
    "agent_entry",
    "skills",
    "module_discovery",
    "documents",
    "runtime",
    "llm_connected"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "mlcc.bundle.v1"
    },
    "name": {
      "const": "mlcc-independent-modules"
    },
    "version": {
      "type": "string",
      "pattern": "^\\d+\\.\\d+\\.\\d+$"
    },
    "interface_version": {
      "const": "1.0"
    },
    "agent_entry": {
      "type": "string",
      "minLength": 1
    },
    "skills": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "module_discovery": {
      "const": "modules/*/module.json"
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "runtime": {
      "const": "python-stdlib-cli"
    },
    "llm_connected": {
      "type": "boolean"
    }
  }
}
