{
  "schemaVersion": "matterai.bundle.v2",
  "name": "mlcc-agent",
  "title": "MLCC 多尺度计算能力包",
  "version": "0.60.1",
  "description": "MLCC 多尺度计算能力包：原子建模、DFT、MD、铁电相场、RVE、器件FEM与电路SPICE独立运行；共用可追溯任务与SSH/Slurm，性质与科学资格由各领域保留。",
  "agent": {
    "name": "mlcc",
    "entry": "agents/mlcc/AGENT.md",
    "skills": [
      "model-mlcc-structures",
      "run-mlcc-dft",
      "run-mlcc-md",
      "run-mlcc-phase-field",
      "run-mlcc-rve",
      "run-mlcc-fem",
      "run-mlcc-spice",
      "compute-mlcc-properties"
    ]
  },
  "mcpServers": [
    {
      "name": "mlcc",
      "transport": "stdio",
      "runtime": "python",
      "entry": "tools/mlcc_mcp.py",
      "args": [
        "--site",
        "zeus://workspace/current/configs/site.v100.json",
        "--workspace",
        "zeus://workspace/current"
      ],
      "allowedTools": [
        "mlcc_list_tasks",
        "mlcc_describe_operations",
        "mlcc_create_operation_task",
        "mlcc_read_result",
        "mlcc_describe_scales",
        "mlcc_create_scale_task",
        "mlcc_read_scale_result",
        "mlcc_prepare_calculation",
        "mlcc_transfer_calculation",
        "mlcc_submit_calculation",
        "mlcc_query_calculation",
        "mlcc_cancel_calculation",
        "mlcc_collect_calculation"
      ],
      "requiredEnv": ["MLCC_SITE_CONFIG", "MLCC_WORKSPACE_ROOT"],
      "permissions": {
        "filesystem": "workspace-write",
        "network": true
      }
    }
  ],
  "requirements": {
    "capabilities": [
      "chat",
      "files",
      "tools",
      "network"
    ]
  },
  "harness": {
    "cases": "harness/cases",
    "format": "matterai.case.v2"
  },
  "catalog": {
    "category": "simulation"
  },
  "risk": "networked"
}
